# Base URL of an Anthropic-compatible Messages API endpoint.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# API key. ANTHROPIC_AUTH_TOKEN is accepted as a fallback.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Model id sent with every request.
MODEL_ID=claude-sonnet-4-5

# Optional: model to fall back to when the primary keeps returning 529s (s15).
# FALLBACK_MODEL_ID=claude-haiku-4-5

# Optional: cheaper model for the /goal completion evaluator (s17).
# GOAL_EVALUATOR_MODEL_ID=claude-haiku-4-5

# Response token budget per model call.
MAX_TOKENS=8192
